/*
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/media/thumb/*
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800
/media/photo/*
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800
/media/poster/*
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800
/media/movie/*
  Content-Type: video/mp4
  Cache-Control: public, max-age=604800
