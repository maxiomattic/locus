{
  // Static files, plus worker.js for movie byte ranges. No other bindings, and
  // nothing that can reach a ship.
  "name": "locus",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/media/movie/*"] }
}
